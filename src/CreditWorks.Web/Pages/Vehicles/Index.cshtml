@page
@model CreditWorks.Web.Pages.Vehicles.IndexModel
@{
    ViewData["Title"] = "Vehicles";
}

<h1>Vehicles</h1>
<a asp-page="/Vehicles/Create" class="btn btn-primary mb-3">Add vehicle</a>

@if (Model.Vehicles.Count == 0)
{
    <p>No vehicles have been added yet.</p>
}
else
{
    <table id="vehicles-table" class="table"
           data-current-sort="@Model.SortBy"
           data-current-desc="@Model.Desc.ToString().ToLowerInvariant()">
        <thead>
            <tr>
                <th aria-sort="@(Model.SortBy == "owner" ? (Model.Desc ? "descending" : "ascending") : "none")">
                    <a data-sort="owner" asp-page="./Index" asp-route-sort="owner"
                       asp-route-desc="@(Model.SortBy == "owner" && !Model.Desc)">
                        Owner <span class="sort-indicator">@(Model.SortBy == "owner" ? (Model.Desc ? "▼" : "▲") : "▲")</span>
                    </a>
                </th>
                <th aria-sort="@(Model.SortBy == "manufacturer" ? (Model.Desc ? "descending" : "ascending") : "none")">
                    <a data-sort="manufacturer" asp-page="./Index" asp-route-sort="manufacturer"
                       asp-route-desc="@(Model.SortBy == "manufacturer" && !Model.Desc)">
                        Manufacturer <span class="sort-indicator">@(Model.SortBy == "manufacturer" ? (Model.Desc ? "▼" : "▲") : "▲")</span>
                    </a>
                </th>
                <th aria-sort="@(Model.SortBy == "year" ? (Model.Desc ? "descending" : "ascending") : "none")">
                    <a data-sort="year" asp-page="./Index" asp-route-sort="year"
                       asp-route-desc="@(Model.SortBy == "year" && !Model.Desc)">
                        Year <span class="sort-indicator">@(Model.SortBy == "year" ? (Model.Desc ? "▼" : "▲") : "▲")</span>
                    </a>
                </th>
                <th aria-sort="@(Model.SortBy == "weight" ? (Model.Desc ? "descending" : "ascending") : "none")">
                    <a data-sort="weight" asp-page="./Index" asp-route-sort="weight"
                       asp-route-desc="@(Model.SortBy == "weight" && !Model.Desc)">
                        Weight (kg) <span class="sort-indicator">@(Model.SortBy == "weight" ? (Model.Desc ? "▼" : "▲") : "▲")</span>
                    </a>
                </th>
                <th>Category</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var vehicle in Model.Vehicles)
        {
            <tr>
                <td>@vehicle.OwnerName</td>
                <td>@vehicle.Manufacturer</td>
                <td>@vehicle.YearOfManufacture</td>
                <td>@vehicle.WeightKg.ToString("0.00")</td>
                <td>
                    <img src="@Url.Content("~/images/categories/" + vehicle.CategoryIconName)"
                         alt="" width="40" height="25" class="me-2" />
                    @vehicle.CategoryName
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
    <script src="~/js/vehicle-sort.js" asp-append-version="true"></script>
}
