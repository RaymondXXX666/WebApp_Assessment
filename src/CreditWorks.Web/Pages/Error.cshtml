@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1>Something went wrong</h1>
<p>We could not complete your request. Please try again later.</p>
<p>If you were saving changes, check the relevant list before submitting again to avoid duplicate changes.</p>
<p>
    <a asp-page="/Vehicles/Index">View vehicles</a>
    <span aria-hidden="true"> · </span>
    <a asp-page="/Categories/Index">View categories</a>
</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}
